diff --git a/variants/thinknode_m9/ThinkNodeM9Board.cpp b/variants/thinknode_m9/ThinkNodeM9Board.cpp
index bf55863..f23f919 100644
--- a/variants/thinknode_m9/ThinkNodeM9Board.cpp
+++ b/variants/thinknode_m9/ThinkNodeM9Board.cpp
@@ -1,6 +1,55 @@
 #include "ThinkNodeM9Board.h"
 
+#ifdef HOPTICS_UI
+#include <Wire.h>
+#include <soc/soc.h>
+#include <soc/usb_serial_jtag_reg.h>
+
+// Board revision, from the keypad controller's I2C address: 1 = v1.0 (0x6C), 2 = v1.1 (0x6D), 0 = not found
+static int m9Version = 0;
+
+// The GPS enable is active-low on v1.0 and active-high on v1.1, as Meshtastic's M9 variant has it
+int hoptics_gps_en_active(void) { return m9Version > 1 ? HIGH : LOW; }
+#endif
+
 void ThinkNodeM9Board::begin() {
+#ifdef HOPTICS_UI
+  // Hoptics-MC: deselect everything on the shared SPI bus before anything talks on it, as Meshtastic does at boot.
+  // A floating microSD chip-select lets the card drive MISO, and the LR1110 then reads as all zeros (radio init -707).
+  for (int cs : {(int)P_LORA_NSS, (int)SDCARD_CS, (int)ST7789_CS}) {
+    pinMode(cs, OUTPUT);
+    digitalWrite(cs, HIGH);
+  }
+  // GPS standby line high = keep the receiver awake (Meshtastic does the same at boot)
+  pinMode(PIN_GPS_STANDBY, OUTPUT);
+  digitalWrite(PIN_GPS_STANDBY, HIGH);
+  delay(100);
+
+  // Which M9 is this? The keypad controller answers at 0x6C on v1.0 and 0x6D on v1.1, on its own bus (SDA 20,
+  // SCL 21). GPIO 20 starts out as a USB pad (the socket goes to a CH340), so hand it to the GPIO matrix first.
+  CLEAR_PERI_REG_MASK(USB_SERIAL_JTAG_CONF0_REG, USB_SERIAL_JTAG_USB_PAD_ENABLE);
+  Wire1.begin(I2C_SDA1, I2C_SCL1, 100000);
+  for (int tries = 0; tries < 5 && !m9Version; tries++) {
+    Wire1.beginTransmission(0x6D);
+    if (Wire1.endTransmission() == 0) { m9Version = 2; break; }
+    Wire1.beginTransmission(0x6C);
+    if (Wire1.endTransmission() == 0) { m9Version = 1; break; }
+    delay(50);
+  }
+  if (m9Version) {
+    // hold time for the keys' long-press codes (Meshtastic sets 700 ms)
+    const uint16_t ms = 700;
+    Wire1.beginTransmission(m9Version == 1 ? 0x6C : 0x6D);
+    Wire1.write(0x03);
+    Wire1.write((ms >> 8) & 0xFF);
+    Wire1.write(ms & 0xFF);
+    Wire1.endTransmission();
+  }
+  if (m9Version)
+    Serial.printf("hoptics: ThinkNode M9 v1.%d\n", m9Version - 1);
+  else
+    Serial.println("hoptics: ThinkNode M9, revision unknown (the keypad didn't answer)");
+#endif
 
   // power on screen
   pinMode(VEXT_ENABLE, OUTPUT);
