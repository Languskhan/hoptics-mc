+// Read-only numbers for Prometheus / Home Assistant: "Authorization: Bearer <token>" (or ?token=). Off until
+// the owner creates a token; the token can't do anything else.
+void WebConfigServer::handleHxMetrics(AsyncWebServerRequest* req) {
+  if (_mode != MODE_LAN || !hx::statsOn()) { req->send(404); return; }
+  String t;
+  if (req->hasHeader("Authorization")) {
+    t = req->header("Authorization");
+    if (!t.startsWith("Bearer ")) t = "";
+    else t = t.substring(7);
+  } else if (req->hasParam("token")) {
+    t = req->getParam("token")->value();
+  }
+  if (!hx::statsTokenOk(t.c_str())) { req->send(401, "text/plain", "token\n"); return; }
+  AsyncResponseStream* res = req->beginResponseStream("text/plain; version=0.0.4");
+  res->addHeader("Cache-Control", "no-store");
+  hx::writeMetrics(*res);
+  req->send(res);
+}
+
+// make a new stats token (off=1 turns the feed off). Admin only; the token is shown once, here.
+void WebConfigServer::handleHxStatsToken(AsyncWebServerRequest* req) {
+  if (_mode != MODE_LAN) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  if (!hxSameOrigin(req)) { req->send(403, "application/json", "{\"error\":\"wrong origin\"}"); return; }
+  const bool off = req->hasParam("off", true);
+  const char* t = hx::statsNewToken(off);
+  String r = String("{\"ok\":true,\"token\":\"") + (off ? "" : t) + "\"}";
+  AsyncWebServerResponse* res = req->beginResponse(200, "application/json", r);
+  res->addHeader("Cache-Control", "no-store");
+  req->send(res);
+}
+
+// Send a channel message: key (32 hex chars, the channel's 16-byte key) and text (1-140 bytes, no control
+// characters). Signed-in admin from this page only; one at a time, 5 s apart.
+void WebConfigServer::handleHxChat(AsyncWebServerRequest* req) {
+  if (_mode != MODE_LAN) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  if (!hxSameOrigin(req)) { req->send(403, "application/json", "{\"error\":\"wrong origin\"}"); return; }
+  if (!req->hasParam("key", true) || !req->hasParam("text", true)) { req->send(400, "application/json", "{\"error\":\"bad request\"}"); return; }
+  const String k = req->getParam("key", true)->value(), t = req->getParam("text", true)->value();
+  if (k.length() != 32 || t.length() < 1 || t.length() > hx::kChatMax) { req->send(400, "application/json", "{\"error\":\"message must be 1-140 bytes\"}"); return; }
+  uint8_t key[16];
+  for (int i = 0; i < 16; i++) {
+    auto hv = [](char c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1; };
+    const int a = hv(k[i * 2]), b = hv(k[i * 2 + 1]);
+    if (a < 0 || b < 0) { req->send(400, "application/json", "{\"error\":\"bad key\"}"); return; }
+    key[i] = (uint8_t)(a << 4 | b);
+  }
+  for (size_t i = 0; i < t.length(); i++) {
+    if ((uint8_t)t[i] < 0x20) { req->send(400, "application/json", "{\"error\":\"no control characters\"}"); return; }
+  }
+  if (!hx::queueChannelMsg(key, t.c_str())) { req->send(429, "application/json", "{\"error\":\"wait a few seconds between messages\"}"); return; }
+  req->send(200, "application/json", "{\"ok\":true}");
+}
+
+// Remote admin of another repeater/room: op=login (pub, password) | cmd (text) | logout. The password goes into
+// one login packet and is wiped; it is never stored or echoed. Signed-in admin from this page only.
+void WebConfigServer::handleHxAdmin(AsyncWebServerRequest* req) {
+  if (_mode != MODE_LAN) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  if (!hxSameOrigin(req)) { req->send(403, "application/json", "{\"error\":\"wrong origin\"}"); return; }
+  const String op = req->hasParam("op", true) ? req->getParam("op", true)->value() : String("");
+  auto bad = [req](int code, const char* e) { req->send(code, "application/json", String("{\"error\":\"") + e + "\"}"); };
+  if (op == "login") {
+    const String h = req->hasParam("pub", true) ? req->getParam("pub", true)->value() : String("");
+    const String pw = req->hasParam("password", true) ? req->getParam("password", true)->value() : String("");
+    uint8_t pub[32];
+    if (h.length() != 64) { bad(400, "bad node"); return; }
+    for (int i = 0; i < 32; i++) {
+      auto hv = [](char c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1; };
+      const int a = hv(h[i * 2]), b = hv(h[i * 2 + 1]);
+      if (a < 0 || b < 0) { bad(400, "bad node"); return; }
+      pub[i] = (uint8_t)(a << 4 | b);
+    }
+    if (pw.length() < 1 || pw.length() > 15) { bad(400, "password: 1-15 characters"); return; }
+    for (size_t i = 0; i < pw.length(); i++) if ((uint8_t)pw[i] < 0x20) { bad(400, "password: no control characters"); return; }
+    const int rc = hx::adminLogin(pub, pw.c_str());
+    if (rc == 1) { bad(409, "turn on direct messages first: remote admin signs in with the chat identity"); return; }
+    if (rc == 2) { bad(404, "pick a repeater or room this node has heard, or save its key as one"); return; }
+    if (rc == 3) { bad(429, "a sign-in is already running"); return; }
+  } else if (op == "cmd") {
+    const String t = req->hasParam("text", true) ? req->getParam("text", true)->value() : String("");
+    if (t.length() < 1 || t.length() > hx::kDmMax) { bad(400, "command: 1-150 characters"); return; }
+    for (size_t i = 0; i < t.length(); i++) if ((uint8_t)t[i] < 0x20) { bad(400, "no control characters"); return; }
+    if (!hx::adminCmd(t.c_str())) { bad(429, "not signed in as admin, or wait a moment between commands"); return; }
+  } else if (op == "logout") {
+    hx::adminLogout();
+  } else { bad(400, "bad request"); return; }
+  req->send(200, "application/json", "{\"ok\":true}");
+}
+
+// Regional analyzer (a CoreScope site) for map names and the new-node alert; "" turns it off. Admin only.
+void WebConfigServer::handleHxRegionSrc(AsyncWebServerRequest* req) {
+  if (_mode != MODE_LAN) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  if (!hxSameOrigin(req)) { req->send(403, "application/json", "{\"error\":\"wrong origin\"}"); return; }
+  const String u = req->hasParam("url", true) ? req->getParam("url", true)->value() : String("");
+  char err[48];
+  if (u.length() > 95 || !hx::regionConfigure(u.c_str(), err, sizeof(err))) {
+    req->send(400, "application/json", String("{\"error\":\"") + (u.length() > 95 ? "too long" : err) + "\"}");
+    return;
+  }
+  req->send(200, "application/json", "{\"ok\":true}");
+}
