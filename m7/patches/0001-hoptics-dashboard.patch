+
+// Same-origin check for state-changing requests: a browser always sends Origin on a cross-site POST, so a page
+// on another site can't drive the update even if the admin is signed in here.
+static bool hxSameOrigin(AsyncWebServerRequest* req) {
+  if (!req->hasHeader("Origin")) return true;  // not a browser cross-site request
+  const String o = req->header("Origin");
+  const String h = req->header("Host");
+  return h.length() > 0 && (o == String("http://") + h);
+}
+
+// Upload state lives outside the session object: the session can be freed while a request is still open,
+// and the disconnect callback below must never touch it.
+static AsyncWebServerRequest* volatile s_hx_up_req = nullptr;  // the one upload allowed at a time
+static volatile bool s_hx_up_ok = false;
+static char s_hx_up_err[64] = "";
+
+static void hxSecurityHeaders(AsyncWebServerResponse* res) {
+  res->addHeader("X-Frame-Options", "DENY");
+  res->addHeader("X-Content-Type-Options", "nosniff");
+  res->addHeader("Referrer-Policy", "no-referrer");
+}
+
+// Firmware update from the dashboard. Only the signed-in admin, from this page, one upload at a time; the image
+// must be an ESP32-S3 app. It is streamed into the spare slot and the node restarts on it only if the whole
+// file arrived and its checksum verified (Update.end); otherwise the running firmware is untouched.
+void WebConfigServer::hxUpload(AsyncWebServerRequest* req, size_t index, uint8_t* data, size_t len, bool final) {
+  if (index == 0) {
+    if (s_hx_up_req && s_hx_up_req != req) return;  // another upload is running; this one gets 409
+    if (_mode != MODE_LAN || !checkAuth(req) || !hxSameOrigin(req)) return;
+    if (len < 16 || data[0] != 0xE9 || data[12] != 0x09 || data[13] != 0x00) {  // image magic, chip id ESP32-S3
+      s_hx_up_req = req;
+      s_hx_up_ok = false;
+      strcpy(s_hx_up_err, "not an ESP32-S3 firmware image");
+      return;
+    }
+    if (Update.isRunning()) Update.abort();
+    s_hx_up_req = req;
+    s_hx_up_err[0] = 0;
+    s_hx_up_ok = Update.begin(UPDATE_SIZE_UNKNOWN, U_FLASH);
+    if (!s_hx_up_ok) { snprintf(s_hx_up_err, sizeof(s_hx_up_err), "can't start: %s", Update.errorString()); return; }
+    req->onDisconnect([req]() {  // dropped mid-way: discard what arrived
+      if (s_hx_up_req != req) return;
+      if (Update.isRunning()) Update.abort();
+      s_hx_up_req = nullptr;
+      s_hx_up_ok = false;
+    });
+    Serial.println("Hoptics: firmware upload started");
+  }
+  if (req != s_hx_up_req || !s_hx_up_ok) return;
+  _last_activity = millis();
+  if (len && Update.write(data, len) != len) {
+    snprintf(s_hx_up_err, sizeof(s_hx_up_err), "write failed: %s", Update.errorString());
+    Update.abort();
+    s_hx_up_ok = false;
+    return;
+  }
+  if (final && !Update.end(true)) {
+    snprintf(s_hx_up_err, sizeof(s_hx_up_err), "not a valid image: %s", Update.errorString());
+    s_hx_up_ok = false;
+  }
+}
+
+void WebConfigServer::handleHxUpdateDone(AsyncWebServerRequest* req) {
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"sign in first\"}"); return; }
+  if (!hxSameOrigin(req)) { req->send(403, "application/json", "{\"error\":\"wrong origin\"}"); return; }
+  if (s_hx_up_req != req) { req->send(409, "application/json", "{\"error\":\"another update is running\"}"); return; }
+  const bool ok = s_hx_up_ok && !s_hx_up_err[0] && Update.isFinished();
+  s_hx_up_req = nullptr;
+  if (!ok) {
+    if (Update.isRunning()) Update.abort();
+    String e = String("{\"error\":\"") + (s_hx_up_err[0] ? s_hx_up_err : "upload incomplete") + "\"}";
+    req->send(400, "application/json", e);
+    return;
+  }
+  Serial.println("Hoptics: firmware updated, restarting");
+  _reboot_at = millis() + 1500;
+  if (_reboot_at == 0) _reboot_at = 1;
+  req->send(200, "application/json", "{\"ok\":true}");
+}
+
+// Alert settings: url (blank keeps it, "-" removes it), flags, or test=1. Signed-in admin from this page only.
+void WebConfigServer::handleHxAlerts(AsyncWebServerRequest* req) {
+  if (_mode != MODE_LAN) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  if (!hxSameOrigin(req)) { req->send(403, "application/json", "{\"error\":\"wrong origin\"}"); return; }
+  if (req->hasParam("test", true)) { hx::alertsTest(); req->send(200, "application/json", "{\"ok\":true}"); return; }
+  const String url = req->hasParam("url", true) ? req->getParam("url", true)->value() : String("");
+  const long flags = req->hasParam("flags", true) ? req->getParam("flags", true)->value().toInt() : 0;
+  if (url.length() > 199 || flags < 0 || flags > 255) { req->send(400, "application/json", "{\"error\":\"bad request\"}"); return; }
+  char err[64];
+  if (!hx::alertsConfigure(url.c_str(), (uint8_t)flags, err, sizeof(err))) {
+    String e = String("{\"error\":\"") + err + "\"}";
+    req->send(400, "application/json", e);
+    return;
+  }
+  req->send(200, "application/json", "{\"ok\":true}");
+}
+
+void WebConfigServer::handleHxPage(AsyncWebServerRequest* req) {
+  if (_mode == MODE_OFF) { req->send(503); return; }
+  AsyncWebServerResponse* res = req->beginResponse(200, "text/html", HX_PAGE_GZ, HX_PAGE_GZ_LEN);
+  res->addHeader("Content-Encoding", "gzip");
+  res->addHeader("Cache-Control", "no-cache");
+  hxSecurityHeaders(res);
+  req->send(res);
+}
+
+// /api/hx?k=packets&since=N | history&from=I | nodes | region&from=I | raw&seq=N | self (signed-in admin only)
+void WebConfigServer::handleHxData(AsyncWebServerRequest* req) {
+  if (_mode == MODE_OFF) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  String k = req->hasParam("k") ? req->getParam("k")->value() : String("self");
+  AsyncResponseStream* res = req->beginResponseStream("application/json");
+  res->addHeader("Cache-Control", "no-store");
+  hxSecurityHeaders(res);
+  if (k == "packets") hx::writePackets(*res, req->hasParam("since") ? strtoul(req->getParam("since")->value().c_str(), NULL, 10) : 0);
+  else if (k == "history") hx::writeHistory(*res, req->hasParam("from") ? strtoul(req->getParam("from")->value().c_str(), NULL, 10) : 0);
+  else if (k == "nodes") hx::writeNodes(*res);
+  else if (k == "alerts") hx::writeAlerts(*res);
+  else if (k == "region") hx::writeRegion(*res, req->hasParam("from") ? strtoul(req->getParam("from")->value().c_str(), NULL, 10) : 0);
+  else if (k == "raw") hx::writeRaw(*res, req->hasParam("seq") ? strtoul(req->getParam("seq")->value().c_str(), NULL, 10) : 0);
+  else hx::writeSelf(*res);
+  req->send(res);
+}
+#endif
