+#ifdef HOPTICS_M7
+// Hoptics dashboard data: neighbours every 15 s, a sample every 5 minutes, and the web page kept running whenever
+// the network is up (it is the node's main screen).
+void MyMesh::hopticsTick() {
+  static uint32_t next_nbr = 0, next_sample = 0, next_web = 0;
+  static bool started = false;
+  uint32_t now = millis();
+  {  // a channel message typed on the dashboard
+    uint8_t key[16];
+    char text[hx::kChatMax + 1];
+    if (hx::takeChannelMsg(key, text, sizeof(text))) {
+      mesh::GroupChannel ch;
+      memset(ch.secret, 0, sizeof(ch.secret));
+      memcpy(ch.secret, key, 16);
+      mesh::Utils::sha256(ch.hash, sizeof(ch.hash), key, 16);
+      uint8_t temp[5 + sizeof(_prefs.node_name) + 2 + hx::kChatMax + 1];
+      const uint32_t ts = getRTCClock()->getCurrentTimeUnique();
+      memcpy(temp, &ts, 4);
+      temp[4] = 0;  // plain text
+      int len = snprintf((char*)&temp[5], sizeof(temp) - 5, "%s: %s", _prefs.node_name, text);
+      if (len > (int)sizeof(temp) - 6) len = sizeof(temp) - 6;
+      if (len > 0) {
+        mesh::Packet* pkt = createGroupDatagram(PAYLOAD_TYPE_GRP_TXT, ch, temp, 5 + len);
+        if (pkt) sendFlood(pkt);
+      }
+    }
+  }
+  if (!started) {
+    hx::bootCheck();  // a new image that keeps failing goes back to the previous one
+    hx::begin();
+    started = true;
+    next_sample = now + 300000UL;
+  }
+  hx::dmTick(*this);  // direct messages typed on the dashboard
+  if ((int32_t)(now - next_nbr) >= 0) {
+    next_nbr = now + 15000UL;
+    hx::setSelf(self_id.pub_key, _prefs.node_name, _prefs.node_lat, _prefs.node_lon);
+#if MAX_NEIGHBOURS
+    hx::Neighbour list[MAX_NEIGHBOURS];
+    int n = 0;
+    for (int i = 0; i < MAX_NEIGHBOURS; i++) {
+      if (neighbours[i].heard_timestamp == 0) continue;
+      memcpy(list[n].pub, neighbours[i].id.pub_key, 4);
+      list[n].snr4 = neighbours[i].snr;
+      list[n].heard = neighbours[i].heard_timestamp;
+      list[n].advert = neighbours[i].advert_timestamp;
+      n++;
+    }
+    hx::setNeighbours(list, n);
+#endif
+  }
+  if ((int32_t)(now - next_sample) >= 0) {
+    next_sample += 300000UL;
+    hx::Sample s;
+    s.t = getRTCClock()->getCurrentTime();
+    s.up = uptime_millis / 1000;
+    s.noise = (int16_t)_radio->getNoiseFloor();
+    s.tx_ms = getTotalAirTime();
+    s.rx_ms = getReceiveAirTime();
+    s.recv = radio_driver.getPacketsRecv();
+    s.sent = radio_driver.getPacketsSent();
+    s.recv_flood = getNumRecvFlood();
+    s.recv_direct = getNumRecvDirect();
+    s.sent_flood = getNumSentFlood();
+    s.sent_direct = getNumSentDirect();
+    s.rx_err = radio_driver.getPacketsRecvErrors();
+    s.nbr_strong = 0;
+    int snr_sum = 0;
+#if MAX_NEIGHBOURS
+    const uint32_t rtc = getRTCClock()->getCurrentTime();
+    for (int i = 0; i < MAX_NEIGHBOURS; i++) {
+      const NeighbourInfo& nb = neighbours[i];
+      if (nb.heard_timestamp == 0 || nb.snr < 0 || rtc - nb.heard_timestamp > 86400) continue;
+      s.nbr_strong++;
+      snr_sum += nb.snr;
+    }
+#endif
+    s.nbr_snr4 = s.nbr_strong ? snr_sum / s.nbr_strong : 0;
+    s.mqtt_ok = s.mqtt_err = 0;
+#ifdef WITH_MQTT_BRIDGE
+    for (int i = 0; i < RUNTIME_MQTT_SLOTS; i++) {
+      MQTTBridge::SlotStatusSnapshot ss;
+      if (!MQTTBridge::getSlotStatusSnapshot(i, &ss)) continue;
+      s.mqtt_ok += ss.publish_ok;
+      s.mqtt_err += ss.publish_err;
+    }
+#endif
+    s.heap = ESP.getFreeHeap();
+    s.temp = (int16_t)temperatureRead();
+    hx::addSample(s);
+  }
+  static bool confirmed = false;
+  if (!confirmed && now > 180000UL && activeNetworkLink().isConnected()) {  // up 3 minutes and online
+    confirmed = true;
+    hx::bootGood();
+  }
+#if defined(WITH_WEBCONFIG) && defined(PIN_USER_BTN_ANA)
+  // Hold the button 5 s for the setup hotspot (the base firmware's: open Wi-Fi, ends after 10 idle minutes).
+  // It needs hands on the box, like USB. Counting starts only after the button was seen up, so a stuck or
+  // floating pin can't start it.
+  static bool btn_armed = false, want_ap = false;
+  static uint32_t next_btn = 0, held_since = 0;
+  if ((int32_t)(now - next_btn) >= 0) {
+    next_btn = now + 50;
+    if (analogRead(PIN_USER_BTN_ANA) >= 20) { btn_armed = true; held_since = 0; }
+    else if (btn_armed) {
+      if (!held_since) held_since = now | 1;
+      else if (now - held_since >= 5000UL) {
+        btn_armed = false;
+        held_since = 0;
+        want_ap = true;
+        char r[96];
+        if (_webconfig) stopWebConfig(r);
+        Serial.println("Hoptics: button held 5 s, starting the setup hotspot");
+      }
+    }
+  }
+  if (want_ap && !_webconfig) {
+    want_ap = false;
+    char r[160];
+    startWebConfig(true, r);
+    Serial.printf("Hoptics: %s\n", r);
+  }
+  {
+    uint8_t led = activeNetworkLink().isConnected() ? 1 : 0;
+#ifdef WITH_WEBCONFIG
+    if (_webconfig && _webconfig->mode() == WebConfigServer::MODE_SETUP) led = 2;
+#endif
+    if (btn_armed && held_since && now - held_since >= 500UL) led = 3;
+    hx::ledTick(led);
+  }
+#else
+  const bool want_ap = false;
+#endif
+#ifdef WITH_WEBCONFIG
+  if ((int32_t)(now - next_web) >= 0) {
+    next_web = now + 10000UL;
+    // leave port 80 alone while `start ota` holds it
+    if (!_webconfig && !want_ap && activeNetworkLink().isConnected() &&
+        HttpPort80Lease::current().load() == HttpPort80Lease::Owner::None) {
+      char reply[160];
+      startWebConfig(false, reply);
+      Serial.printf("Hoptics: %s\n", reply);
+    }
+  }
+#endif
+}
+#endif
