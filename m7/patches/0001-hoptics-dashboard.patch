+  if (!hx::roomQueuePost(t.c_str())) { req->send(429, "application/json", "{\"error\":\"wait a few seconds (room roles only)\"}"); return; }
+  req->send(200, "application/json", "{\"ok\":true}");
+}
+
+// Trace route: path = repeater IDs as hex, 2 characters each (1 to 16 hops). Signed-in admin from this page only.
+void WebConfigServer::handleHxTrace(AsyncWebServerRequest* req) {
+  if (_mode != MODE_LAN) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  if (!hxSameOrigin(req)) { req->send(403, "application/json", "{\"error\":\"wrong origin\"}"); return; }
+  const String h = req->hasParam("path", true) ? req->getParam("path", true)->value() : String("");
+  uint8_t path[hx::kTraceMax];
+  const int n = h.length() / 2;
+  if (h.length() % 2 || n < 1 || n > hx::kTraceMax) { req->send(400, "application/json", "{\"error\":\"1-16 repeater IDs\"}"); return; }
+  for (int i = 0; i < n; i++) {
+    auto hv = [](char c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1; };
+    const int a = hv(h[i * 2]), b = hv(h[i * 2 + 1]);
+    if (a < 0 || b < 0) { req->send(400, "application/json", "{\"error\":\"bad ID\"}"); return; }
+    path[i] = (uint8_t)(a << 4 | b);
+  }
+  if (!hx::traceStart(path, n)) { req->send(429, "application/json", "{\"error\":\"a trace is running, try again in a few seconds\"}"); return; }
+  req->send(200, "application/json", "{\"ok\":true}");
+}
+
+// Direct messages: op=send (to, text) | advert | on (name) | off | save (pub, name) | forget (pub).
+// Signed-in admin from this page only; the mesh loop does the sending.
+void WebConfigServer::handleHxDm(AsyncWebServerRequest* req) {
+  if (_mode != MODE_LAN) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  if (!hxSameOrigin(req)) { req->send(403, "application/json", "{\"error\":\"wrong origin\"}"); return; }
+  auto param = [req](const char* n) { return req->hasParam(n, true) ? req->getParam(n, true)->value() : String(""); };
+  auto bad = [req](const char* e) { req->send(400, "application/json", String("{\"error\":\"") + e + "\"}"); };
+  auto pubFrom = [](const String& h, uint8_t* out) {
+    if (h.length() != 64) return false;
+    for (int i = 0; i < 32; i++) {
+      auto hv = [](char c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; };
+      const int a = hv(h[i * 2]), b = hv(h[i * 2 + 1]);
+      if (a < 0 || b < 0) return false;
+      out[i] = (uint8_t)(a << 4 | b);
+    }
+    return true;
+  };
+  auto nameOk = [](const String& n) {   // printable, and none of the characters adverts reject
+    if (n.length() > 31) return false;
+    for (size_t i = 0; i < n.length(); i++) { const uint8_t c = n[i]; if (c < 0x20 || strchr("[]\\:,?*\"", c)) return false; }
+    return true;
+  };
+  const String op = param("op");
+  uint8_t pub[32];
+  if (op == "send") {
+    const String t = param("text");
+    if (!pubFrom(param("to"), pub)) { bad("bad contact"); return; }
+    if (t.length() < 1 || t.length() > hx::kDmMax) { bad("message must be 1-150 bytes"); return; }
+    for (size_t i = 0; i < t.length(); i++) if ((uint8_t)t[i] < 0x20) { bad("no control characters"); return; }
+    if (!hx::dmQueue(pub, t.c_str())) { req->send(429, "application/json", "{\"error\":\"busy: wait for the last message, or a few seconds\"}"); return; }
+  } else if (op == "advert") {
+    if (!hx::dmAdvert()) { req->send(429, "application/json", "{\"error\":\"one advert a minute\"}"); return; }
+  } else if (op == "on" || op == "off") {
+    const String n = param("name");
+    if (!nameOk(n)) { bad("name: up to 31 characters, no [ ] \\ : , ? * \""); return; }
+    if (!hx::dmEnable(op == "on", n.c_str())) { req->send(503, "application/json", "{\"error\":\"not ready, try again in a moment\"}"); return; }
+  } else if (op == "save" || op == "forget") {
+    const String n = param("name");
+    if (!pubFrom(param("pub"), pub)) { bad("public key: 64 hex characters"); return; }
+    if (!nameOk(n)) { bad("name: up to 31 characters, no [ ] \\ : , ? * \""); return; }
+    const String ty = param("type");
+    const uint8_t type = ty == "repeater" ? 2 : ty == "room" ? 3 : 1;
+    if (!hx::dmSaveContact(pub, n.c_str(), op == "save", type)) { bad("can't save: 16 saved contacts at most"); return; }
+  } else { bad("bad request"); return; }
+  req->send(200, "application/json", "{\"ok\":true}");
+}
+
+// Alert settings: url (blank keeps it, "-" removes it), flags, or test=1. Signed-in admin from this page only.
+void WebConfigServer::handleHxAlerts(AsyncWebServerRequest* req) {
+  if (_mode != MODE_LAN) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  if (!hxSameOrigin(req)) { req->send(403, "application/json", "{\"error\":\"wrong origin\"}"); return; }
+  if (req->hasParam("test", true)) { hx::alertsTest(); req->send(200, "application/json", "{\"ok\":true}"); return; }
+  const String url = req->hasParam("url", true) ? req->getParam("url", true)->value() : String("");
+  const long flags = req->hasParam("flags", true) ? req->getParam("flags", true)->value().toInt() : 0;
+  if (url.length() > 199 || flags < 0 || flags > 255) { req->send(400, "application/json", "{\"error\":\"bad request\"}"); return; }
+  char err[64];
+  if (!hx::alertsConfigure(url.c_str(), (uint8_t)flags, err, sizeof(err))) {
+    String e = String("{\"error\":\"") + err + "\"}";
+    req->send(400, "application/json", e);
+    return;
+  }
+  req->send(200, "application/json", "{\"ok\":true}");
+}
+
+void WebConfigServer::handleHxPage(AsyncWebServerRequest* req) {
+  if (_mode == MODE_OFF) { req->send(503); return; }
+  AsyncWebServerResponse* res = req->beginResponse(200, "text/html", HX_PAGE_GZ, HX_PAGE_GZ_LEN);
+  res->addHeader("Content-Encoding", "gzip");
+  res->addHeader("Cache-Control", "no-cache");
+  hxSecurityHeaders(res);
+  req->send(res);
+}
+
+// /api/hx?k=packets&since=N | history&from=I | nodes | region&from=I | raw&seq=N | self (signed-in admin only)
+void WebConfigServer::handleHxData(AsyncWebServerRequest* req) {
+  // LAN only: the setup hotspot skips sign-in, so it must not serve messages, packets or alert settings
+  if (_mode != MODE_LAN) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  String k = req->hasParam("k") ? req->getParam("k")->value() : String("self");
+  AsyncResponseStream* res = req->beginResponseStream("application/json");
+  res->addHeader("Cache-Control", "no-store");
+  hxSecurityHeaders(res);
+  if (k == "packets") hx::writePackets(*res, req->hasParam("since") ? strtoul(req->getParam("since")->value().c_str(), NULL, 10) : 0);
+  else if (k == "history") hx::writeHistory(*res, req->hasParam("from") ? strtoul(req->getParam("from")->value().c_str(), NULL, 10) : 0);
+  else if (k == "nodes") hx::writeNodes(*res);
+  else if (k == "alerts") hx::writeAlerts(*res);
+  else if (k == "statson") res->print(hx::statsOn() ? "{\"on\":true}" : "{\"on\":false}");
+  else if (k == "admin") hx::writeAdmin(*res);
+  else if (k == "room") hx::writeRoom(*res);
+  else if (k == "trace") hx::writeTrace(*res);
+  else if (k == "dm") hx::writeDm(*res, req->hasParam("since") ? strtoul(req->getParam("since")->value().c_str(), NULL, 10) : 0);
+  else if (k == "grp") hx::writeGroup(*res, req->hasParam("since") ? strtoul(req->getParam("since")->value().c_str(), NULL, 10) : 0);
+  else if (k == "region") hx::writeRegion(*res, req->hasParam("from") ? strtoul(req->getParam("from")->value().c_str(), NULL, 10) : 0);
+  else if (k == "raw") hx::writeRaw(*res, req->hasParam("seq") ? strtoul(req->getParam("seq")->value().c_str(), NULL, 10) : 0);
+  else hx::writeSelf(*res);
+  req->send(res);
+}
+#endif
