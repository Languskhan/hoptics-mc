 }
 
 #endif  // ESP_PLATFORM && WITH_MQTT_BRIDGE
+
+#ifdef HOPTICS_M7
+#include "HopticsData.h"
+#include "HopticsPage.h"  // HX_PAGE_GZ / HX_PAGE_GZ_LEN: the dashboard, gzipped at build time
+
+void WebConfigServer::handleHxPage(AsyncWebServerRequest* req) {
+  if (_mode == MODE_OFF) { req->send(503); return; }
+  AsyncWebServerResponse* res = req->beginResponse(200, "text/html", HX_PAGE_GZ, HX_PAGE_GZ_LEN);
+  res->addHeader("Content-Encoding", "gzip");
+  res->addHeader("Cache-Control", "no-cache");
+  req->send(res);
+}
+
+// /api/hx?k=packets&since=N | history&from=T | nodes | raw&seq=N | self
+void WebConfigServer::handleHxData(AsyncWebServerRequest* req) {
+  if (_mode == MODE_OFF) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  String k = req->hasParam("k") ? req->getParam("k")->value() : String("self");
+  AsyncResponseStream* res = req->beginResponseStream("application/json");
+  if (k == "packets") hx::writePackets(*res, req->hasParam("since") ? strtoul(req->getParam("since")->value().c_str(), NULL, 10) : 0);
+  else if (k == "history") hx::writeHistory(*res, req->hasParam("from") ? strtoul(req->getParam("from")->value().c_str(), NULL, 10) : 0);
+  else if (k == "nodes") hx::writeNodes(*res);
+  else if (k == "raw") hx::writeRaw(*res, req->hasParam("seq") ? strtoul(req->getParam("seq")->value().c_str(), NULL, 10) : 0);
+  else hx::writeSelf(*res);
+  req->send(res);
+}
+#endif
