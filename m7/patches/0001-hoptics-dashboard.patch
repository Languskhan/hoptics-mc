+// Room post as the room itself (room roles only). Signed-in admin from this page only.
+void WebConfigServer::handleHxRoom(AsyncWebServerRequest* req) {
+  if (_mode != MODE_LAN) { req->send(503); return; }
+  if (!checkAuth(req)) { req->send(401, "application/json", "{\"error\":\"auth\"}"); return; }
+  if (!hxSameOrigin(req)) { req->send(403, "application/json", "{\"error\":\"wrong origin\"}"); return; }
+  const String t = req->hasParam("text", true) ? req->getParam("text", true)->value() : String("");
