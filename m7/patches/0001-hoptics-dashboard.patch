diff --git a/src/helpers/esp32/WebConfigServer.cpp b/src/helpers/esp32/WebConfigServer.cpp
index 167e5cd..10cb7ac 100644
--- a/src/helpers/esp32/WebConfigServer.cpp
+++ b/src/helpers/esp32/WebConfigServer.cpp
@@ -690,8 +690,42 @@ uint32_t WebConfigServer::handlerRefCount() const {
   return refs;
 }
 
+#ifdef HOPTICS_M7
+// A web page on another site can point its own domain name at this node's IP (DNS rebinding). Browsers always
+// send the name they used in Host, so in LAN mode anything that isn't an IPv4 address or a meshcore-* local
+// name is refused.
+static bool hxHostOk(AsyncWebServerRequest* req) {
+  if (!req->hasHeader("Host")) return true;
+  String h = req->header("Host");
+  const int colon = h.indexOf(':');
+  if (colon >= 0) h = h.substring(0, colon);
+  h.toLowerCase();
+  if (h.length() == 0 || h.length() > 63) return false;
+  int dots = 0;
+  bool ip = true;
+  for (size_t i = 0; i < h.length(); i++) {
+    if (h[i] == '.') dots++;
+    else if (h[i] < '0' || h[i] > '9') { ip = false; break; }
+  }
+  if (ip && dots == 3) return true;
+  // the node's DHCP name: meshcore-<name>, optionally .local / .lan / .home (names only a local resolver answers)
+  for (const char* sfx : {".local", ".lan", ".home"}) {
+    if (h.endsWith(sfx)) { h = h.substring(0, h.length() - strlen(sfx)); break; }
+  }
+  if (!h.startsWith("meshcore-") || h.length() <= 9) return false;
+  for (size_t i = 0; i < h.length(); i++) {
+    const char c = h[i];
+    if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-')) return false;
+  }
+  return true;
+}
+#endif
+
 void WebConfigServer::dispatchRequest(AsyncWebServerRequest* req, RequestHandler handler) {
   wcLogReq(req);
+#ifdef HOPTICS_M7
+  if (_active && _active->_mode == MODE_LAN && !hxHostOk(req)) { req->send(421, "text/plain", "wrong host"); return; }
+#endif
   WebConfigServer* target = NULL;
